# Subspace Frequency configuration
# Copy to .env and fill in every value marked REQUIRED before `docker compose up`.
# Generate secrets with e.g.: openssl rand -hex 32

# Public origin browsers use to reach the web edge (no trailing slash). REQUIRED
PUBLIC_ORIGIN=http://localhost:8080
WEB_PORT=8080

# Auth. REQUIRED
JWT_SECRET=

# Link previews. The embed image proxy signs URLs with this key (defaults to one derived
# from JWT_SECRET). Optional.
MEDIA_PROXY_SECRET=

# Database. REQUIRED
POSTGRES_USER=subspace
POSTGRES_PASSWORD=
POSTGRES_DB=subspace_frequency

# MinIO object storage. REQUIRED
MINIO_ROOT_USER=subspace_minio
MINIO_ROOT_PASSWORD=

# LiveKit SFU. REQUIRED
LIVEKIT_API_KEY=subspace
LIVEKIT_API_SECRET=
# Leave empty to use PUBLIC_ORIGIN (the web edge proxies /rtc to LiveKit).
LIVEKIT_PUBLIC_URL=

# Cloud drive imports into the Vault (optional; each drive is off unless its ID and secret
# are set). Register this redirect URI with each provider, once per site origin:
#   <origin>/api/v1/vault/drives/google/callback   (Google Cloud console, scope drive.readonly)
#   <origin>/api/v1/vault/drives/onedrive/callback (Microsoft Entra app, Files.Read + User.Read)
#   <origin>/api/v1/vault/drives/dropbox/callback  (Dropbox app console, files.content.read)
# Keep the secrets in your real .env only.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_API_KEY=
ONEDRIVE_CLIENT_ID=
ONEDRIVE_CLIENT_SECRET=
DROPBOX_APP_KEY=
DROPBOX_APP_SECRET=
# Fixed origin for drive sign-in redirects (defaults to the origin the user is on).
DRIVE_REDIRECT_BASE=
# Key that encrypts stored drive tokens (defaults to one derived from JWT_SECRET).
DRIVE_TOKEN_KEY=

# Local development without Docker (vite dev server proxy target)
VITE_BACKEND_HOST=127.0.0.1

# --- Native (non-Docker) runs only; docker-compose sets its own values ---
# Derived automatically by scripts/native/env.mjs when unset:
#   DATABASE_URL        postgresql://POSTGRES_USER:POSTGRES_PASSWORD@127.0.0.1:5432/POSTGRES_DB
#   TEST_DATABASE_URL   same, with database POSTGRES_DB_test
#   REDIS_URL           redis://127.0.0.1:6379
#   S3_ENDPOINT         127.0.0.1:9000
#   S3_PUBLIC_ENDPOINT  http://localhost:5173 (Vite proxies /subspace-vault to MinIO)
