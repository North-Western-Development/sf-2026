# Subspace Frequency Local / Testing Configuration
NODE_ENV=development

# Database
POSTGRES_USER=subspace
POSTGRES_PASSWORD=subspace_secret
POSTGRES_DB=subspace_frequency
DATABASE_URL=postgresql://subspace:subspace_secret@postgres:5432/subspace_frequency

# Redis
REDIS_URL=redis://redis:6379

# Ports & Internal Hosts
API_PORT=3001
GATEWAY_PORT=3002
FILE_PORT=3003

# MinIO S3
MINIO_ROOT_USER=minio_subspace
MINIO_ROOT_PASSWORD=minio_secret_subspace
S3_ENDPOINT=minio:9000
S3_BUCKET=subspace-vault

# LiveKit SFU
LIVEKIT_KEYS="subspace_api_key: subspace_secret_key_frequency"
LIVEKIT_URL=http://livekit:7880

# Cloud Drive Integrations (Phase 6)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_API_KEY=

ONEDRIVE_CLIENT_ID=
ONEDRIVE_CLIENT_SECRET=

DROPBOX_APP_KEY=
DROPBOX_APP_SECRET=
