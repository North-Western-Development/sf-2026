# Subspace Frequency configuration
# Copy to .env and fill in every value marked REQUIRED before `docker compose up`.
# Generate secrets with e.g.: openssl rand -hex 32

# Public origin browsers use to reach the web edge (no trailing slash). REQUIRED
PUBLIC_ORIGIN=http://localhost:8080
WEB_PORT=8080

# Auth. REQUIRED
JWT_SECRET=
# Passkeys: origins allowed to register and use them (default PUBLIC_ORIGIN; comma-separated),
# and the relying-party ID (default: that origin's hostname). Optional.
WEBAUTHN_ORIGINS=
RP_ID=

# Link previews. The embed image proxy signs URLs with this key (defaults to one derived
# from JWT_SECRET). Optional.
MEDIA_PROXY_SECRET=

# Outgoing email (verification links, email-change notices). Without SMTP_HOST, production
# sends nothing and leaves new accounts verified; development keeps a log instead.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Subspace Frequency <no-reply@example.com>
# Fixed base for links in email (defaults to the origin the user is on).
EMAIL_LINK_BASE=

# Text messages for phone verification (Twilio). Without all three, phone verification is off
# (development can set SMS_DEV_OUTBOX=true to keep texts in a Redis list, dev:sms, instead).
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
# Longest private note someone can keep about a person (their own profile included). Optional.
# NOTE_MAX_LENGTH=1024

# Spam limits, as count/window (m, h or d). Defaults shown.
# PHONE_VERIFY_PER_USER=1/30d      finished verifications per account
# PHONE_VERIFY_PER_IP=1/72h        finished verifications per network address
# PHONE_CODES_PER_USER=3/24h       codes texted per account
# PHONE_CODES_PER_NUMBER=3/24h     codes texted to one number
# PHONE_CODES_PER_IP=5/72h         codes texted from one address
# PHONE_CODE_ATTEMPTS=5            wrong guesses before a code is void
# PHONE_COUNTRIES=+1,+44           only these calling codes (default: any)
# No verifying from VPNs, proxies or hosting providers: checked with proxycheck.io (free for 100
# checks a day without a key), and/or a file of CIDR ranges. PHONE_VPN_CHECK=off disables the lookup.
# PHONE_VPN_CHECK=proxycheck
# PROXYCHECK_API_KEY=
# PHONE_VPN_BLOCKLIST=/etc/subspace/vpn-ranges.txt

# true: refuse the EU, the EEA and the UK, where the GDPR applies. Their network addresses get a
# 401 (the web app shows a block page), and their email domains and phone numbers are refused.
# Addresses come from BLOCK_EU_RANGES (deploy/server/eu-ranges.sh writes it from DB-IP Lite).
# BLOCK_EU=false
# BLOCK_EU_RANGES=/etc/subspace/eu-ranges.csv

# Subspace Vault limits for accounts outside any storage group (Command Console › Storage Groups).
DEFAULT_STORAGE_QUOTA_MB=500
DEFAULT_MAX_UPLOAD_MB=50

# true: browsers send and receive voice and video only through LiveKit's TURN server (needs
# turn.enabled in the LiveKit config). Media always goes through LiveKit, never peer to peer.
# LIVEKIT_FORCE_RELAY=false

# Proxies whose X-Forwarded-For is believed (rate limits use the client address). Default
# "loopback" fits nginx on the same host; Docker needs "loopback,uniquelocal".
# TRUST_PROXY=loopback

# Database. REQUIRED
POSTGRES_USER=subspace
POSTGRES_PASSWORD=
POSTGRES_DB=subspace_frequency

# MinIO object storage. REQUIRED
MINIO_ROOT_USER=subspace_minio
MINIO_ROOT_PASSWORD=

# LiveKit SFU. REQUIRED
LIVEKIT_API_KEY=subspace
LIVEKIT_API_SECRET=
# Leave empty to use PUBLIC_ORIGIN (the web edge proxies /rtc to LiveKit).
LIVEKIT_PUBLIC_URL=

# Cloud drive imports into the Vault (optional; each drive is off unless its ID and secret
# are set). Register this redirect URI with each provider, once per site origin:
#   <origin>/api/v1/vault/drives/google/callback   (Google Cloud console, scope drive.readonly)
#   <origin>/api/v1/vault/drives/onedrive/callback (Microsoft Entra app, Files.Read + User.Read)
#   <origin>/api/v1/vault/drives/dropbox/callback  (Dropbox app console, files.content.read)
# Keep the secrets in your real .env only.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_API_KEY=
ONEDRIVE_CLIENT_ID=
ONEDRIVE_CLIENT_SECRET=
DROPBOX_APP_KEY=
DROPBOX_APP_SECRET=
# Fixed origin for drive sign-in redirects (defaults to the origin the user is on).
DRIVE_REDIRECT_BASE=
# Key that encrypts stored drive tokens (defaults to one derived from JWT_SECRET).
DRIVE_TOKEN_KEY=

# Connections (User Settings › Connections). Google, Microsoft and Dropbox reuse the drive
# credentials above but need one more redirect URI each; GitHub needs its own OAuth app:
#   <origin>/api/v1/connections/google/callback     (scopes openid profile email)
#   <origin>/api/v1/connections/microsoft/callback  (User.Read)
#   <origin>/api/v1/connections/dropbox/callback    (account_info.read)
#   <origin>/api/v1/connections/github/callback     (read:user)
# Steam needs no app; STEAM_API_KEY only adds the Steam persona name.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
STEAM_API_KEY=
# Fixed origin for connection sign-in redirects (defaults to DRIVE_REDIRECT_BASE, then the origin).
CONNECTIONS_REDIRECT_BASE=

# GIF search in the GIF picker (optional), through GIPHY: https://developers.giphy.com
GIPHY_API_KEY=

# Mobile push (apps/mobile) through the Expo push service. Optional: an access token is only
# needed when "enhanced push security" is turned on for the Expo project.
EXPO_ACCESS_TOKEN=

# Local development without Docker (vite dev server proxy target)
VITE_BACKEND_HOST=127.0.0.1

# --- Native (non-Docker) runs only; docker-compose sets its own values ---
# Derived automatically by scripts/native/env.mjs when unset:
#   DATABASE_URL        postgresql://POSTGRES_USER:POSTGRES_PASSWORD@127.0.0.1:5432/POSTGRES_DB
#   TEST_DATABASE_URL   same, with database POSTGRES_DB_test
#   REDIS_URL           redis://127.0.0.1:6379
#   S3_ENDPOINT         127.0.0.1:9000
#   S3_PUBLIC_ENDPOINT  http://localhost:5173 (Vite proxies /subspace-vault to MinIO)

# Snowflake IDs: give every process that writes to the database its own worker number
# (0-1023). The server's release step sets one per service; without it, the process id is used.
# SNOWFLAKE_WORKER_ID=1
