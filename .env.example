# Subspace Frequency configuration
# Copy to .env and fill in every value marked REQUIRED before `docker compose up`.
# Generate secrets with e.g.: openssl rand -hex 32

# Public origin browsers use to reach the web edge (no trailing slash). REQUIRED
PUBLIC_ORIGIN=http://localhost:8080
WEB_PORT=8080

# Auth. REQUIRED
JWT_SECRET=

# Database. REQUIRED
POSTGRES_USER=subspace
POSTGRES_PASSWORD=
POSTGRES_DB=subspace_frequency

# MinIO object storage. REQUIRED
MINIO_ROOT_USER=subspace_minio
MINIO_ROOT_PASSWORD=

# LiveKit SFU. REQUIRED
LIVEKIT_API_KEY=subspace
LIVEKIT_API_SECRET=
# Leave empty to use PUBLIC_ORIGIN (the web edge proxies /rtc to LiveKit).
LIVEKIT_PUBLIC_URL=

# Cloud drive integrations (optional; each is disabled unless set).
# Public client identifiers only - never put client secrets in this file.
GOOGLE_CLIENT_ID=
GOOGLE_API_KEY=
ONEDRIVE_CLIENT_ID=
DROPBOX_APP_KEY=

# Local development without Docker (vite dev server proxy target)
VITE_BACKEND_HOST=127.0.0.1

# --- Native (non-Docker) runs only; docker-compose sets its own values ---
# Derived automatically by scripts/native/env.mjs when unset:
#   DATABASE_URL        postgresql://POSTGRES_USER:POSTGRES_PASSWORD@127.0.0.1:5432/POSTGRES_DB
#   TEST_DATABASE_URL   same, with database POSTGRES_DB_test
#   REDIS_URL           redis://127.0.0.1:6379
#   S3_ENDPOINT         127.0.0.1:9000
#   S3_PUBLIC_ENDPOINT  http://localhost:5173 (Vite proxies /subspace-vault to MinIO)
