{
  "name": "subspace-frequency",
  "version": "0.1.0",
  "private": true,
  "description": "Subspace Frequency - Space-themed real-time communications platform",
  "license": "PolyForm-Small-Business-1.0.0",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "test": "vitest run tests/unit && turbo run test",
    "test:unit": "vitest run tests/unit",
    "test:web": "pnpm --filter @subspace/web test",
    "test:e2e": "vitest run --config vitest.config.ts",
    "lint": "turbo run lint",
    "clean": "turbo run clean && rm -rf node_modules",
    "dev:native": "node scripts/native/dev.mjs",
    "test:native": "node scripts/native/test.mjs",
    "test:ui": "playwright test",
    "test:live": "playwright test --config playwright.live.config.ts"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/mailparser": "3.4.5",
    "@types/smtp-server": "3.5.10",
    "@types/ws": "^8.5.14",
    "ioredis": "^5.11.1",
    "mailparser": "3.7.2",
    "smtp-server": "3.13.6",
    "turbo": "^2.4.4",
    "typescript": "^5.7.3",
    "vitest": "^3.0.7",
    "ws": "^8.18.0"
  },
  "packageManager": "pnpm@10.30.2"
}
