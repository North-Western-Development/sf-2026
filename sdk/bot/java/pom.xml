<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>click.subspace</groupId>
  <artifactId>subspace-bot</artifactId>
  <version>0.1.0</version>
  <packaging>jar</packaging>

  <name>Subspace Bot SDK</name>
  <description>Build bots for Subspace Frequency: REST, the real-time gateway, slash commands and interactions. JDK only, no dependencies.</description>
  <url>https://subspace.click</url>

  <properties>
    <maven.compiler.release>17</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
  </properties>

  <!-- No dependencies: java.net.http (HttpClient, WebSocket) and the JDK's Ed25519 only. -->
  <dependencies />

  <build>
    <plugins>
      <!-- The tests use a small built-in runner (no JUnit): `mvn verify` runs it after packaging. -->
      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>exec-maven-plugin</artifactId>
        <version>3.5.0</version>
        <executions>
          <execution>
            <id>sdk-tests</id>
            <phase>integration-test</phase>
            <goals>
              <goal>java</goal>
            </goals>
            <configuration>
              <mainClass>click.subspace.bot.SdkTests</mainClass>
              <classpathScope>test</classpathScope>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-source-plugin</artifactId>
        <version>3.3.1</version>
        <executions>
          <execution>
            <id>attach-sources</id>
            <goals>
              <goal>jar-no-fork</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
