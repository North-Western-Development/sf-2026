{
  "expo": {
    "name": "Subspace Frequency",
    "slug": "subspace-frequency",
    "scheme": "subspace",
    "version": "0.2.0",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#030305",
    "splash": {
      "image": "./assets/icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#030305"
    },
    "ios": {
      "bundleIdentifier": "click.subspace.mobile",
      "supportsTablet": true,
      "infoPlist": {
        "NSCameraUsageDescription": "Subspace uses the camera for video in calls and Comm-Links.",
        "NSMicrophoneUsageDescription": "Subspace uses the microphone for voice in calls and Comm-Links.",
        "UIBackgroundModes": [
          "audio",
          "remote-notification"
        ]
      },
      "buildNumber": "2"
    },
    "android": {
      "package": "click.subspace.mobile",
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#030305"
      },
      "permissions": [
        "CAMERA",
        "RECORD_AUDIO",
        "MODIFY_AUDIO_SETTINGS",
        "POST_NOTIFICATIONS"
      ],
      "versionCode": 2,
      "blockedPermissions": [
        "com.google.android.c2dm.permission.RECEIVE",
        "com.google.android.finsky.permission.BIND_GET_INSTALL_REFERRER_SERVICE",
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_IMAGES"
      ]
    },
    "plugins": [
      [
        "expo-notifications",
        {
          "color": "#3B8EF2",
          "mode": "production"
        }
      ],
      "./plugins/with-android-build"
    ]
  }
}
