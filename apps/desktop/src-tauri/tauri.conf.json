{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Subspace Frequency",
  "version": "0.1.0",
  "identifier": "click.subspace.desktop",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; connect-src https: http:; img-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi", "dmg", "app", "appimage", "deb"],
    "category": "SocialNetworking",
    "shortDescription": "Subspace Frequency",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"]
  }
}
