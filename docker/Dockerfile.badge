FROM node:22-alpine AS base
WORKDIR /app
RUN npm install -g pnpm@10.30.2

COPY pnpm-lock.yaml* pnpm-workspace.yaml package.json turbo.json tsconfig.base.json ./
COPY packages ./packages
COPY apps/badge-worker ./apps/badge-worker

RUN pnpm install --frozen-lockfile=false
RUN pnpm --filter @subspace/constants build
RUN pnpm --filter @subspace/database build
RUN pnpm --filter @subspace/badge-worker build

CMD ["pnpm", "--filter", "@subspace/badge-worker", "start"]
